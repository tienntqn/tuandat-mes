# =============================================================================
# TUANDAT MES - Environment Variables
# Copy file này thành .env và điền giá trị thực
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=tuandat_mes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

# --- NestJS API ---
API_PORT=3000
NODE_ENV=development
# Phải là chuỗi ngẫu nhiên đủ dài (>= 32 chars)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# --- Nghiệp vụ ---
# Giờ khóa nhập sản lượng (HH:mm, Asia/Ho_Chi_Minh)
OUTPUT_CUTOFF_TIME=19:00
# Timezone
TZ=Asia/Ho_Chi_Minh

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Prisma (dùng khi chạy migration local) ---
DATABASE_URL=postgresql://postgres:your_strong_password_here@localhost:5432/tuandat_mes

# --- Frontend (Vite — phải prefix VITE_) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=Tuấn Đạt MES
