// Prisma Schema — Tuấn Đạt MES
// Giai đoạn 1: Database Schema hoàn chỉnh

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum FactoryStatus {
  ACTIVE
  INACTIVE
}

enum EmployeePosition {
  COMPANY_PLANNER
  BOD
  ADMIN
  FACTORY_DIRECTOR
  FACTORY_PLANNER
  LINE_LEADER
  LINE_DEPUTY
  MECHANIC
}

enum MachineType {
  SEWING
  PROGRAMMABLE
  SEAM_SEALING
  CUTTING
  OTHER
}

enum MachineStatus {
  RUNNING
  IDLE
  MAINTENANCE
  BROKEN
  STOPPED
}

enum MaintenanceType {
  PERIODIC
  REPAIR
}

enum TransferStatus {
  PENDING
  SENDER_CONFIRMED
  COMPLETED
  REJECTED
}

enum POStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionStage {
  CUTTING
  SEWING
  QC
  PACKING
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
}

// ============================================================
// MASTER DATA
// ============================================================

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  taxCode   String?   @unique
  phone     String?
  email     String?
  address   String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  factories Factory[]
}

model Factory {
  id        Int           @id @default(autoincrement())
  companyId Int
  code      String        @unique
  name      String
  address   String?
  phone     String?
  status    FactoryStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  company         Company           @relation(fields: [companyId], references: [id])
  productionLines ProductionLine[]
  employees       Employee[]
  machines        Machine[]
  companyPlans    CompanyPlan[]
  transfersFrom   MachineTransfer[] @relation("TransferFrom")
  transfersTo     MachineTransfer[] @relation("TransferTo")

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model ProductionLine {
  id         Int           @id @default(autoincrement())
  factoryId  Int
  lineNumber Int
  name       String
  workerCount Int          @default(10)
  status     FactoryStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  factory      Factory       @relation(fields: [factoryId], references: [id])
  employees    Employee[]
  machines     Machine[]
  factoryPlans FactoryPlan[]
  dailyOutputs DailyOutput[]
  styleLines   StyleLine[]

  @@unique([factoryId, lineNumber])
  @@index([factoryId])
  @@index([status])
  @@index([deletedAt])
}

model Employee {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  fullName  String
  phone     String?
  email     String?
  position  EmployeePosition
  factoryId Int?
  lineId    Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  factory           Factory?          @relation(fields: [factoryId], references: [id])
  line              ProductionLine?   @relation(fields: [lineId], references: [id])
  user              User?
  transfersSent     MachineTransfer[] @relation("TransferSender")
  transfersReceived MachineTransfer[] @relation("TransferReceiver")

  @@index([factoryId])
  @@index([lineId])
  @@index([position])
  @@index([deletedAt])
}

// ============================================================
// MÁY MÓC
// ============================================================

model Machine {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         MachineType
  factoryId    Int
  lineId       Int?
  status       MachineStatus @default(IDLE)
  brand        String?
  model        String?
  purchaseDate DateTime?     @db.Date
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  factory      Factory            @relation(fields: [factoryId], references: [id])
  line         ProductionLine?    @relation(fields: [lineId], references: [id])
  maintenances MachineMaintenance[]
  transfers    MachineTransfer[]

  @@index([factoryId])
  @@index([lineId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
}

model MachineMaintenance {
  id              Int             @id @default(autoincrement())
  machineId       Int
  maintenanceDate DateTime        @db.Date
  type            MaintenanceType
  description     String?
  performedBy     String?
  cost            Decimal?        @db.Decimal(15, 2)
  nextDueDate     DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([maintenanceDate])
  @@index([nextDueDate])
}

model MachineTransfer {
  id                  Int            @id @default(autoincrement())
  machineId           Int
  transferOrderNo     String         @unique
  transferDate        DateTime       @db.Date
  reason              String?
  fromFactoryId       Int
  toFactoryId         Int
  senderId            Int
  senderConfirmedAt   DateTime?
  receiverId          Int
  receiverConfirmedAt DateTime?
  status              TransferStatus @default(PENDING)
  rejectReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  machine     Machine @relation(fields: [machineId], references: [id])
  fromFactory Factory @relation("TransferFrom", fields: [fromFactoryId], references: [id])
  toFactory   Factory  @relation("TransferTo", fields: [toFactoryId], references: [id])
  sender      Employee @relation("TransferSender", fields: [senderId], references: [id])
  receiver    Employee @relation("TransferReceiver", fields: [receiverId], references: [id])

  @@index([machineId])
  @@index([fromFactoryId])
  @@index([toFactoryId])
  @@index([status])
  @@index([transferDate])
}

// ============================================================
// KHÁCH HÀNG & MÃ HÀNG
// ============================================================

model Customer {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  country     String?
  contactInfo String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  styles Style[]

  @@index([deletedAt])
}

model Style {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  customerId  Int
  season      String?
  image       String?
  description String?
  sam         Decimal?  @db.Decimal(10, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer       Customer        @relation(fields: [customerId], references: [id])
  purchaseOrders PurchaseOrder[]
  companyPlans   CompanyPlan[]
  dailyOutputs   DailyOutput[]
  styleLines     StyleLine[]

  @@index([customerId])
  @@index([deletedAt])
}

model PurchaseOrder {
  id            Int       @id @default(autoincrement())
  poNumber      String    @unique
  styleId       Int
  totalQuantity Int
  deliveryDate  DateTime  @db.Date
  status        POStatus  @default(OPEN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  style        Style         @relation(fields: [styleId], references: [id])
  companyPlans CompanyPlan[]

  @@index([styleId])
  @@index([status])
  @@index([deliveryDate])
  @@index([deletedAt])
}

// ============================================================
// KẾ HOẠCH SẢN XUẤT 2 CẤP
// ============================================================

// Cấp 1: Phòng kế hoạch CÔNG TY phân chỉ tiêu xuống XƯỞNG
// Ràng buộc: tổng plannedQuantity theo poId ≤ PO.totalQuantity (kiểm tra ở application layer)
model CompanyPlan {
  id                 Int      @id @default(autoincrement())
  styleId            Int
  poId               Int
  factoryId          Int
  plannedQuantity    Int
  startDate          DateTime @db.Date
  expectedFinishDate DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  style        Style         @relation(fields: [styleId], references: [id])
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  factory      Factory       @relation(fields: [factoryId], references: [id])
  factoryPlans FactoryPlan[]

  @@index([styleId])
  @@index([poId])
  @@index([factoryId])
  @@index([startDate])
  @@index([expectedFinishDate])
}

// Cấp 2: Kế hoạch XƯỞNG phân chỉ tiêu xuống CHUYỀN
// Ràng buộc: tổng plannedQuantity theo companyPlanId ≤ CompanyPlan.plannedQuantity (kiểm tra ở application layer)
// Tự động tạo StyleLine khi tạo FactoryPlan
model FactoryPlan {
  id                 Int      @id @default(autoincrement())
  companyPlanId      Int
  lineId             Int
  plannedQuantity    Int
  expectedFinishDate DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyPlan CompanyPlan    @relation(fields: [companyPlanId], references: [id])
  line        ProductionLine @relation(fields: [lineId], references: [id])

  @@index([companyPlanId])
  @@index([lineId])
  @@index([expectedFinishDate])
}

// ============================================================
// SẢN LƯỢNG HÀNG NGÀY
// ============================================================

// UNIQUE (lineId, styleId, stage, outputDate) đảm bảo upsert "lấy lần cuối"
// isLocked = true sau cutoff time (mặc định 19:00)
model DailyOutput {
  id         Int             @id @default(autoincrement())
  lineId     Int
  styleId    Int
  stage      ProductionStage
  outputDate DateTime        @db.Date
  quantity   Int
  enteredBy  Int
  enteredAt  DateTime        @default(now())
  isLocked   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  line  ProductionLine   @relation(fields: [lineId], references: [id])
  style Style            @relation(fields: [styleId], references: [id])
  logs  DailyOutputLog[]

  @@unique([lineId, styleId, stage, outputDate])
  @@index([lineId])
  @@index([styleId])
  @@index([outputDate])
  @@index([stage])
  @@index([isLocked])
}

// Audit trail: lưu MỌI lần nhập, kể cả khi upsert ghi đè
model DailyOutputLog {
  id            Int      @id @default(autoincrement())
  dailyOutputId Int
  quantity      Int
  enteredBy     Int
  enteredAt     DateTime @default(now())

  dailyOutput DailyOutput @relation(fields: [dailyOutputId], references: [id])

  @@index([dailyOutputId])
  @@index([enteredAt])
}

// ============================================================
// AUTH & RBAC
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @unique
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee  Employee   @relation(fields: [employeeId], references: [id])
  userRoles UserRole[]

  @@index([isActive])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id       Int              @id @default(autoincrement())
  resource String
  action   PermissionAction

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

// Bảng nối User N-N Role
model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

// Bảng nối Role N-N Permission
model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Bảng nối ProductionLine N-N Style
// Được tạo tự động khi FactoryPlan được tạo
model StyleLine {
  lineId  Int
  styleId Int

  line  ProductionLine @relation(fields: [lineId], references: [id])
  style Style          @relation(fields: [styleId], references: [id])

  @@id([lineId, styleId])
  @@index([styleId])
}
