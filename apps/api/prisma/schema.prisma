// Prisma Schema — Tuấn Đạt MES
// Giai đoạn 1: Database Schema hoàn chỉnh

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum FactoryStatus {
  ACTIVE
  INACTIVE
}

enum EmployeePosition {
  COMPANY_PLANNER
  BOD
  ADMIN
  FACTORY_DIRECTOR
  FACTORY_PLANNER
  LINE_LEADER
  LINE_DEPUTY
  MECHANIC
  CUTTING_LEADER // Tổ trưởng Cắt (cấp xưởng)
  FINISHING_LEADER // Tổ trưởng Hoàn thành (cấp xưởng)
  QC_LEADER // Tổ trưởng KCS (cấp xưởng)
  ACCOUNTANT // Kế toán (cấp công ty)
}

// Tổ cấp xưởng nhập sản lượng theo ma trận màu × size (Cắt, KCS)
enum FactorySection {
  CUTTING
  QC
}

enum MachineType {
  SEWING
  PROGRAMMABLE
  SEAM_SEALING
  CUTTING
  OTHER
}

enum MachineStatus {
  RUNNING
  IDLE
  MAINTENANCE
  BROKEN
  STOPPED
}

enum MaintenanceType {
  PERIODIC
  REPAIR
}

enum TransferStatus {
  PENDING
  SENDER_CONFIRMED
  COMPLETED
  REJECTED
}

enum POStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
}

// ============================================================
// MÀU & SIZE (catalog dùng chung)
// ============================================================

model Color {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  hex       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  styleColors          StyleColor[]
  poItems              PoItem[]
  dailyOutputs         DailyOutput[]
  deliveryItems        DeliveryItem[]
  factorySectionOutputs FactorySectionOutput[]

  @@index([deletedAt])
}

model Size {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  styleSizes           StyleSize[]
  poItems              PoItem[]
  dailyOutputs         DailyOutput[]
  deliveryItems        DeliveryItem[]
  factorySectionOutputs FactorySectionOutput[]

  @@index([sortOrder])
  @@index([deletedAt])
}

// Màu/size của một mã hàng (Style có những màu/size nào)
model StyleColor {
  id      Int @id @default(autoincrement())
  styleId Int
  colorId Int

  style Style @relation(fields: [styleId], references: [id])
  color Color @relation(fields: [colorId], references: [id])

  @@unique([styleId, colorId])
  @@index([styleId])
  @@index([colorId])
}

model StyleSize {
  id      Int @id @default(autoincrement())
  styleId Int
  sizeId  Int

  style Style @relation(fields: [styleId], references: [id])
  size  Size  @relation(fields: [sizeId], references: [id])

  @@unique([styleId, sizeId])
  @@index([styleId])
  @@index([sizeId])
}

// Phân bổ PO theo ma trận màu × size (Σ quantity = PO.totalQuantity)
model PoItem {
  id       Int @id @default(autoincrement())
  poId     Int
  colorId  Int
  sizeId   Int
  quantity Int

  po    PurchaseOrder @relation(fields: [poId], references: [id])
  color Color         @relation(fields: [colorId], references: [id])
  size  Size          @relation(fields: [sizeId], references: [id])

  @@unique([poId, colorId, sizeId])
  @@index([poId])
  @@index([colorId])
  @@index([sizeId])
}

enum ProductionStage {
  CUTTING
  SEWING
  QC
  PACKING
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
}

// ============================================================
// MASTER DATA
// ============================================================

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  taxCode   String?   @unique
  phone     String?
  email     String?
  address   String?
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  factories Factory[]
}

model Factory {
  id        Int           @id @default(autoincrement())
  companyId Int
  code      String        @unique
  name      String
  address   String?
  phone     String?
  status    FactoryStatus @default(ACTIVE)
  // Số công nhân tổ Cắt / Hoàn thành cấp xưởng (dùng để chia lương bình quân)
  cuttingWorkerCount   Int @default(0)
  finishingWorkerCount Int @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  company         Company           @relation(fields: [companyId], references: [id])
  productionLines ProductionLine[]
  employees       Employee[]
  machines        Machine[]
  companyPlans    CompanyPlan[]
  transfersFrom   MachineTransfer[] @relation("TransferFrom")
  transfersTo     MachineTransfer[] @relation("TransferTo")
  factorySectionOutputs FactorySectionOutput[]
  finishingOutputs      FinishingOutput[]
  repairProposals       RepairProposal[]
  // Phân hệ MMTB mở rộng
  machineHandovers    MachineHandover[]
  breakdownReports    BreakdownReport[]
  incidentReports     IncidentReport[]
  maintenanceRequests MaintenanceRequest[]
  workPlans           WorkPlan[]
  workOrders          WorkOrder[]
  partRequests        PartRequest[]
  sparePartStocks     SparePartStock[]
  stockMovements      StockMovement[]

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model ProductionLine {
  id         Int           @id @default(autoincrement())
  factoryId  Int
  lineNumber Int
  name       String
  workerCount Int          @default(10)
  status     FactoryStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  factory      Factory       @relation(fields: [factoryId], references: [id])
  employees    Employee[]
  machines     Machine[]
  factoryPlans FactoryPlan[]
  dailyOutputs DailyOutput[]
  styleLines   StyleLine[]
  breakdownReports BreakdownReport[]
  machineHandovers MachineHandover[]

  @@unique([factoryId, lineNumber])
  @@index([factoryId])
  @@index([status])
  @@index([deletedAt])
}

model Employee {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  fullName  String
  phone     String?
  email     String?
  position  EmployeePosition
  factoryId Int?
  lineId    Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  factory           Factory?          @relation(fields: [factoryId], references: [id])
  line              ProductionLine?   @relation(fields: [lineId], references: [id])
  user              User?
  transfersSent     MachineTransfer[] @relation("TransferSender")
  transfersReceived MachineTransfer[] @relation("TransferReceiver")
  salarySlips       SalarySlip[]

  @@index([factoryId])
  @@index([lineId])
  @@index([position])
  @@index([deletedAt])
}

// ============================================================
// MÁY MÓC
// ============================================================

model Machine {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  type         MachineType
  factoryId    Int
  lineId       Int?
  status       MachineStatus @default(IDLE)
  brand        String? // tên hãng dạng text (giữ tương thích) — ưu tiên brandId
  brandId      Int?
  categoryId   Int? // chủng loại/chức năng
  model        String?
  serialNo     String?
  manufactureYear Int? // năm sản xuất
  purchaseDate DateTime?     @db.Date
  warrantyExpiry DateTime?   @db.Date // hạn bảo hành
  note         String?
  liquidatedAt DateTime? // đã thanh lý (ẩn khỏi danh sách)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  factory         Factory             @relation(fields: [factoryId], references: [id])
  line            ProductionLine?     @relation(fields: [lineId], references: [id])
  brandRef        MachineBrand?       @relation(fields: [brandId], references: [id])
  category        MachineCategory?    @relation(fields: [categoryId], references: [id])
  maintenances    MachineMaintenance[]
  transfers       MachineTransfer[]
  images          MachineImage[]
  liquidation     MachineLiquidation?
  repairProposals RepairProposal[]
  // Phân hệ MMTB mở rộng
  handovers           MachineHandover[]
  certificates        MachineCertificate[]
  documents           MachineDocument[]
  norms               MaintenanceNorm[]
  breakdownReports    BreakdownReport[]
  incidentReports     IncidentReport[]
  maintenanceRequests MaintenanceRequest[]
  workPlanItems       WorkPlanItem[]
  workOrders          WorkOrder[]
  statusLogs          MachineStatusLog[]

  @@index([factoryId])
  @@index([lineId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@index([liquidatedAt])
}

model MachineMaintenance {
  id              Int             @id @default(autoincrement())
  machineId       Int
  maintenanceDate DateTime        @db.Date
  type            MaintenanceType
  description     String?
  performedBy     String?
  cost            Decimal?        @db.Decimal(15, 2)
  nextDueDate     DateTime?       @db.Date
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([maintenanceDate])
  @@index([nextDueDate])
}

model MachineTransfer {
  id                  Int            @id @default(autoincrement())
  machineId           Int
  transferOrderNo     String         @unique
  transferDate        DateTime       @db.Date
  reason              String?
  fromFactoryId       Int
  toFactoryId         Int
  senderId            Int
  senderConfirmedAt   DateTime?
  receiverId          Int
  receiverConfirmedAt DateTime?
  status              TransferStatus @default(PENDING)
  rejectReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  machine     Machine @relation(fields: [machineId], references: [id])
  fromFactory Factory @relation("TransferFrom", fields: [fromFactoryId], references: [id])
  toFactory   Factory  @relation("TransferTo", fields: [toFactoryId], references: [id])
  sender      Employee @relation("TransferSender", fields: [senderId], references: [id])
  receiver    Employee @relation("TransferReceiver", fields: [receiverId], references: [id])

  @@index([machineId])
  @@index([fromFactoryId])
  @@index([toFactoryId])
  @@index([status])
  @@index([transferDate])
}

// ============================================================
// KHÁCH HÀNG & MÃ HÀNG
// ============================================================

model Customer {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  country     String?
  contactInfo String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  styles Style[]
  orders Order[]

  @@index([deletedAt])
}

model Style {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  customerId  Int
  season      String?
  image       String?
  description String?
  sam         Decimal?  @db.Decimal(10, 4)
  // Có quản lý sản lượng theo Màu×Size không. Tắt = chỉ nhập tổng/ngày cho May & Cắt.
  trackByColorSize Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer       Customer        @relation(fields: [customerId], references: [id])
  purchaseOrders PurchaseOrder[]
  companyPlans   CompanyPlan[]
  dailyOutputs   DailyOutput[]
  styleLines     StyleLine[]
  styleColors    StyleColor[]
  styleSizes     StyleSize[]
  factorySectionOutputs FactorySectionOutput[]

  @@index([customerId])
  @@index([deletedAt])
}

model PurchaseOrder {
  id            Int       @id @default(autoincrement())
  poNumber      String    @unique
  styleId       Int
  orderId       Int?
  totalQuantity Int
  deliveryDate  DateTime  @db.Date
  // Đơn giá gia công / sản phẩm. subsidyPrice = giá thay thế do BOD trợ giá (ưu tiên khi tính lương)
  unitPrice     Decimal?  @db.Decimal(12, 2)
  subsidyPrice  Decimal?  @db.Decimal(12, 2)
  status        POStatus  @default(OPEN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  style         Style          @relation(fields: [styleId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  companyPlans  CompanyPlan[]
  deliveryPlans DeliveryPlan[]
  items         PoItem[]
  finishingOutputs FinishingOutput[]

  @@index([styleId])
  @@index([orderId])
  @@index([status])
  @@index([deliveryDate])
  @@index([deletedAt])
}

// Đơn đặt hàng của khách (Order) — 1 Order gồm nhiều PO
model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @unique
  customerId   Int
  orderDate    DateTime    @db.Date
  deliveryDate DateTime?   @db.Date
  status       OrderStatus @default(OPEN)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  customer       Customer        @relation(fields: [customerId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
}

// Kế hoạch giao hàng theo PO (kế hoạch vs thực giao)
model DeliveryPlan {
  id              Int            @id @default(autoincrement())
  poId            Int
  plannedDate     DateTime       @db.Date
  plannedQuantity Int
  actualDate      DateTime?      @db.Date
  actualQuantity  Int?
  status          DeliveryStatus @default(PENDING)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  po    PurchaseOrder  @relation(fields: [poId], references: [id])
  items DeliveryItem[]

  @@index([poId])
  @@index([plannedDate])
  @@index([status])
  @@index([deletedAt])
}

// Phân bổ một lần giao hàng theo ma trận màu × size (packing list)
// Σ quantity = DeliveryPlan.actualQuantity (giao thực tế)
model DeliveryItem {
  id             Int @id @default(autoincrement())
  deliveryPlanId Int
  colorId        Int
  sizeId         Int
  quantity       Int

  deliveryPlan DeliveryPlan @relation(fields: [deliveryPlanId], references: [id])
  color        Color        @relation(fields: [colorId], references: [id])
  size         Size         @relation(fields: [sizeId], references: [id])

  @@unique([deliveryPlanId, colorId, sizeId])
  @@index([deliveryPlanId])
  @@index([colorId])
  @@index([sizeId])
}

// ============================================================
// KẾ HOẠCH SẢN XUẤT 2 CẤP
// ============================================================

// Cấp 1: Phòng kế hoạch CÔNG TY phân chỉ tiêu xuống XƯỞNG
// Ràng buộc: tổng plannedQuantity theo poId ≤ PO.totalQuantity (kiểm tra ở application layer)
model CompanyPlan {
  id                 Int      @id @default(autoincrement())
  styleId            Int
  poId               Int
  factoryId          Int
  plannedQuantity    Int
  startDate          DateTime @db.Date
  expectedFinishDate DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  style        Style         @relation(fields: [styleId], references: [id])
  po           PurchaseOrder @relation(fields: [poId], references: [id])
  factory      Factory       @relation(fields: [factoryId], references: [id])
  factoryPlans FactoryPlan[]

  @@index([styleId])
  @@index([poId])
  @@index([factoryId])
  @@index([startDate])
  @@index([expectedFinishDate])
}

// Cấp 2: Kế hoạch XƯỞNG phân chỉ tiêu xuống CHUYỀN
// Ràng buộc: tổng plannedQuantity theo companyPlanId ≤ CompanyPlan.plannedQuantity (kiểm tra ở application layer)
// Tự động tạo StyleLine khi tạo FactoryPlan
model FactoryPlan {
  id                 Int      @id @default(autoincrement())
  companyPlanId      Int
  lineId             Int
  plannedQuantity    Int
  expectedFinishDate DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyPlan CompanyPlan    @relation(fields: [companyPlanId], references: [id])
  line        ProductionLine @relation(fields: [lineId], references: [id])

  @@index([companyPlanId])
  @@index([lineId])
  @@index([expectedFinishDate])
}

// ============================================================
// SẢN LƯỢNG HÀNG NGÀY
// ============================================================

// UNIQUE (lineId, styleId, stage, outputDate) đảm bảo upsert "lấy lần cuối"
// isLocked = true sau cutoff time (mặc định 19:00)
model DailyOutput {
  id         Int             @id @default(autoincrement())
  lineId     Int
  styleId    Int
  colorId    Int?
  sizeId     Int?
  stage      ProductionStage
  outputDate DateTime        @db.Date
  quantity   Int
  enteredBy  Int
  enteredAt  DateTime        @default(now())
  isLocked   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  line  ProductionLine   @relation(fields: [lineId], references: [id])
  style Style            @relation(fields: [styleId], references: [id])
  color Color?           @relation(fields: [colorId], references: [id])
  size  Size?            @relation(fields: [sizeId], references: [id])
  logs  DailyOutputLog[]

  @@unique([lineId, styleId, colorId, sizeId, stage, outputDate])
  @@index([lineId])
  @@index([styleId])
  @@index([outputDate])
  @@index([stage])
  @@index([isLocked])
}

// Audit trail: lưu MỌI lần nhập, kể cả khi upsert ghi đè
model DailyOutputLog {
  id            Int      @id @default(autoincrement())
  dailyOutputId Int
  quantity      Int
  enteredBy     Int
  enteredAt     DateTime @default(now())

  dailyOutput DailyOutput @relation(fields: [dailyOutputId], references: [id])

  @@index([dailyOutputId])
  @@index([enteredAt])
}

// ============================================================
// KẾ TOÁN — BẢNG LƯƠNG (upload Excel + gửi email nhân viên)
// ============================================================

// 1 kỳ lương = 1 file Excel được kế toán upload cho 1 tháng/năm
model SalaryPeriod {
  id             Int       @id @default(autoincrement())
  month          Int // 1-12, do kế toán chọn khi upload
  year           Int
  sourceFileName String
  uploadedBy     Int
  uploadedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  uploader User         @relation(fields: [uploadedBy], references: [id])
  slips    SalarySlip[]

  @@unique([month, year])
  @@index([deletedAt])
}

// 1 dòng lương của 1 nhân viên trong kỳ — map trực tiếp cột B..AH của file Excel gốc
model SalarySlip {
  id           Int     @id @default(autoincrement())
  periodId     Int
  employeeId   Int? // null nếu MSNV không khớp nhân viên nào trong hệ thống
  employeeCode String // MSNV (cột C) — giữ nguyên dù khớp hay không
  fullName     String // D - Họ Tên
  department   String? // B - Phòng
  bankAccount  String? // E - STK
  email        String? // AP - email nhận lương

  workDays                Decimal @default(0) @db.Decimal(14, 2) // F  Ngày công
  otSundayNight           Decimal @default(0) @db.Decimal(14, 2) // G  Tăng ca CN, đêm
  otNormalHours           Decimal @default(0) @db.Decimal(14, 2) // I  Tăng ca bình thường (giờ)
  totalWorkHours          Decimal @default(0) @db.Decimal(14, 2) // J  Tổng giờ làm việc
  convertedWorkDays       Decimal @default(0) @db.Decimal(14, 2) // K  Ngày công quy đổi
  workCoefficient         Decimal @default(0) @db.Decimal(14, 2) // L  Hệ số làm việc
  salaryRate              Decimal @default(0) @db.Decimal(14, 2) // M  Mức lương
  otNormalPay             Decimal @default(0) @db.Decimal(14, 2) // N  Tiền lương tăng ca bình thường
  performanceCoefficient  Decimal @default(0) @db.Decimal(14, 2) // O  Hệ số phụ cấp gắn KQCV
  salarySupport           Decimal @default(0) @db.Decimal(14, 2) // P  Hỗ trợ lương
  fuelAllowance           Decimal @default(0) @db.Decimal(14, 2) // Q  PC xăng xe
  attendanceBonus         Decimal @default(0) @db.Decimal(14, 2) // R  Tiền chuyên cần
  incentiveBonus          Decimal @default(0) @db.Decimal(14, 2) // S  Tiền thi đua
  holidayPay              Decimal @default(0) @db.Decimal(14, 2) // T  Tiền lương ngày lễ, tết
  paidPersonalLeave       Decimal @default(0) @db.Decimal(14, 2) // U  Việc riêng có lương
  leaveSupport            Decimal @default(0) @db.Decimal(14, 2) // V  Hỗ trợ ngày phép
  leaveDays               Decimal @default(0) @db.Decimal(14, 2) // W  Ngày phép
  leavePay                Decimal @default(0) @db.Decimal(14, 2) // X  Tiền phép
  trainingDays            Decimal @default(0) @db.Decimal(14, 2) // Y  Công HL
  menstrualHours          Decimal @default(0) @db.Decimal(14, 2) // Z  Giờ hành kinh
  womenSpecialPay         Decimal @default(0) @db.Decimal(14, 2) // AA Lương phụ nữ ngày HK, huấn luyện
  totalSalary             Decimal @default(0) @db.Decimal(14, 2) // AB Tổng cộng tiền lương
  unemploymentInsurance   Decimal @default(0) @db.Decimal(14, 2) // AC BHTNg
  socialInsurance         Decimal @default(0) @db.Decimal(14, 2) // AD 9.5% BHXH
  otherDeduction          Decimal @default(0) @db.Decimal(14, 2) // AE Trừ khác
  advanceDeduction        Decimal @default(0) @db.Decimal(14, 2) // AF Trừ ứng ngoài
  personalIncomeTax       Decimal @default(0) @db.Decimal(14, 2) // AG Trừ thuế TNCN
  netSalary               Decimal @default(0) @db.Decimal(14, 2) // AH Tiền lương thực nhận cuối kỳ

  emailSentAt DateTime?
  emailError  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period   SalaryPeriod @relation(fields: [periodId], references: [id])
  employee Employee?    @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeCode])
  @@index([periodId])
  @@index([employeeId])
}

// ============================================================
// SẢN LƯỢNG TỔ CẤP XƯỞNG (Cắt, KCS) — theo ma trận màu × size
// Throughput của tổ ≈ tổng các chuyền của xưởng; nhập trực tiếp ở cấp xưởng.
// ============================================================
model FactorySectionOutput {
  id         Int            @id @default(autoincrement())
  factoryId  Int
  section    FactorySection
  styleId    Int
  // Cho phép NULL khi mã hàng ở chế độ chỉ nhập tổng (không theo màu/size)
  colorId    Int?
  sizeId     Int?
  outputDate DateTime       @db.Date
  quantity   Int
  enteredBy  Int
  enteredAt  DateTime       @default(now())
  isLocked   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  factory Factory                   @relation(fields: [factoryId], references: [id])
  style   Style                     @relation(fields: [styleId], references: [id])
  color   Color?                    @relation(fields: [colorId], references: [id])
  size    Size?                     @relation(fields: [sizeId], references: [id])
  logs    FactorySectionOutputLog[]

  @@unique([factoryId, section, styleId, colorId, sizeId, outputDate])
  @@index([factoryId])
  @@index([section])
  @@index([styleId])
  @@index([outputDate])
}

// Audit trail cho sản lượng tổ cấp xưởng
model FactorySectionOutputLog {
  id                     Int      @id @default(autoincrement())
  factorySectionOutputId Int
  quantity               Int
  enteredBy              Int
  enteredAt              DateTime @default(now())

  output FactorySectionOutput @relation(fields: [factorySectionOutputId], references: [id])

  @@index([factorySectionOutputId])
  @@index([enteredAt])
}

// ============================================================
// SẢN LƯỢNG TỔ HOÀN THÀNH — theo PO (không quan tâm màu/size)
// receivedQuantity: hàng nhận từ các chuyền may; packedQuantity: đã đóng thùng.
// ============================================================
model FinishingOutput {
  id               Int      @id @default(autoincrement())
  factoryId        Int
  poId             Int
  outputDate       DateTime @db.Date
  receivedQuantity Int      @default(0)
  packedQuantity   Int      @default(0)
  enteredBy        Int
  enteredAt        DateTime @default(now())
  isLocked         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  factory Factory               @relation(fields: [factoryId], references: [id])
  po      PurchaseOrder         @relation(fields: [poId], references: [id])
  logs    FinishingOutputLog[]

  @@unique([factoryId, poId, outputDate])
  @@index([factoryId])
  @@index([poId])
  @@index([outputDate])
}

// Audit trail cho sản lượng tổ hoàn thành (lưu cả 2 con số mỗi lần nhập)
model FinishingOutputLog {
  id                Int      @id @default(autoincrement())
  finishingOutputId Int
  receivedQuantity  Int
  packedQuantity    Int
  enteredBy         Int
  enteredAt         DateTime @default(now())

  output FinishingOutput @relation(fields: [finishingOutputId], references: [id])

  @@index([finishingOutputId])
  @@index([enteredAt])
}

// ============================================================
// CẤU HÌNH HỆ THỐNG (key/value, ghi được vào DB)
// ============================================================
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// AUTH & RBAC
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @unique
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee            Employee       @relation(fields: [employeeId], references: [id])
  userRoles           UserRole[]
  uploadedSalaryPeriods SalaryPeriod[]

  @@index([isActive])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id       Int              @id @default(autoincrement())
  resource String
  action   PermissionAction

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

// Bảng nối User N-N Role
model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
}

// Bảng nối Role N-N Permission
model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Bảng nối ProductionLine N-N Style
// Được tạo tự động khi FactoryPlan được tạo
model StyleLine {
  lineId  Int
  styleId Int
  // Đơn giá gia công riêng của chuyền cho mã hàng này (vd chuyền thiếu công đoạn ép keo).
  // Để trống = lấy theo đơn giá PO khi tính lương.
  unitPrice Decimal? @db.Decimal(12, 2)

  line  ProductionLine @relation(fields: [lineId], references: [id])
  style Style          @relation(fields: [styleId], references: [id])

  @@id([lineId, styleId])
  @@index([styleId])
}

// ============================================================
// QUẢN LÝ MÁY MÓC — DANH MỤC & MỞ RỘNG
// ============================================================

enum RepairProposalType {
  REPAIR // sửa chữa
  REPLACEMENT // thay thế
}

enum RepairProposalStatus {
  DRAFT // nháp
  PENDING // chờ duyệt
  APPROVED // đã duyệt
  REJECTED // từ chối
  DONE // hoàn thành
}

enum AttachmentType {
  IMAGE
  VIDEO
}

// Hãng sản xuất (Juki, Brother, Eastman...)
model MachineBrand {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  country   String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  machines Machine[]

  @@index([deletedAt])
}

// Chủng loại / chức năng máy (1 kim, 2 kim, ép keo, trải vải...)
model MachineCategory {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  machines   Machine[]
  spareParts SparePart[]
  norms      MaintenanceNorm[]

  @@index([deletedAt])
}

// Phụ tùng máy (bo mạch, dây cua roa, motor, màn hình...)
model SparePart {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  name       String
  unit       String? // đơn vị: cái, bộ, mét...
  categoryId Int? // nhóm theo chủng loại máy (tùy chọn)
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category    MachineCategory?     @relation(fields: [categoryId], references: [id])
  repairItems RepairProposalItem[]
  // Phân hệ MMTB mở rộng
  normItems      MaintenanceNormItem[]
  workOrderParts WorkOrderPart[]
  requestItems   PartRequestItem[]
  stocks         SparePartStock[]
  movements      StockMovement[]

  @@index([categoryId])
  @@index([deletedAt])
}

// Hình ảnh của máy (nhiều ảnh / 1 máy)
model MachineImage {
  id        Int      @id @default(autoincrement())
  machineId Int
  url       String
  caption   String?
  createdAt DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

// Lịch sử thanh lý máy (1-1 với máy đã thanh lý)
model MachineLiquidation {
  id              Int      @id @default(autoincrement())
  machineId       Int      @unique
  liquidationDate DateTime @db.Date
  reason          String
  decisionNo      String?
  salvageValue    Decimal? @db.Decimal(15, 2)
  approvedBy      String?
  note            String?
  createdAt       DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

// Đề xuất sửa chữa / thay thế máy (3 bước: Nháp → Chờ → Duyệt/Từ chối → Hoàn thành)
model RepairProposal {
  id            Int                  @id @default(autoincrement())
  proposalNo    String               @unique
  machineId     Int
  factoryId     Int
  type          RepairProposalType   @default(REPAIR)
  status        RepairProposalStatus @default(DRAFT)
  title         String
  description   String?
  estimatedCost Decimal?             @db.Decimal(15, 2)
  requestedBy   Int // employeeId người đề xuất
  approvedBy    Int? // employeeId người duyệt
  approvedAt    DateTime?
  rejectReason  String?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  machine     Machine                     @relation(fields: [machineId], references: [id])
  factory     Factory                     @relation(fields: [factoryId], references: [id])
  items       RepairProposalItem[]
  attachments RepairProposalAttachment[]

  @@index([machineId])
  @@index([factoryId])
  @@index([status])
}

// Dòng phụ tùng/hạng mục trong 1 đề xuất
model RepairProposalItem {
  id          Int     @id @default(autoincrement())
  proposalId  Int
  sparePartId Int?
  name        String // tên hạng mục/phụ tùng (cho phép nhập tự do)
  quantity    Int     @default(1)
  unit        String?
  note        String?

  proposal  RepairProposal @relation(fields: [proposalId], references: [id])
  sparePart SparePart?     @relation(fields: [sparePartId], references: [id])

  @@index([proposalId])
  @@index([sparePartId])
}

// Tệp đính kèm (ảnh/video) của đề xuất
model RepairProposalAttachment {
  id         Int            @id @default(autoincrement())
  proposalId Int
  type       AttachmentType
  url        String
  filename   String?
  createdAt  DateTime       @default(now())

  proposal RepairProposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
}

// ============================================================
// PHÂN HỆ QUẢN LÝ MÁY MÓC THIẾT BỊ (MMTB)
// Luồng: Khai báo → Sửa chữa / Bảo dưỡng → Theo dõi vật tư
//        → Lý lịch máy → Hồ sơ máy
// ============================================================

// ---------- ENUMS ----------

// Loại biên bản bàn giao máy
enum HandoverType {
  RECEIVE           // bàn giao nhận máy (khi khai báo máy mới)
  AFTER_REPAIR      // bàn giao sau sửa chữa
  AFTER_MAINTENANCE // bàn giao sau bảo dưỡng
}

enum HandoverStatus {
  DRAFT
  PENDING_RECEIVER // bên giao đã ký, chờ bên nhận xác nhận
  COMPLETED
  REJECTED
}

// Loại chứng chỉ / kiểm định của máy
enum CertificateType {
  INSPECTION  // kiểm định an toàn
  CALIBRATION // hiệu chuẩn
  QUALITY     // chứng nhận chất lượng (CO/CQ)
  OTHER
}

// Mức độ nghiêm trọng của hỏng hóc
enum BreakdownSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakdownStatus {
  REPORTED     // vừa báo hỏng, chờ cơ điện tiếp nhận
  ACKNOWLEDGED // cơ điện đã tiếp nhận
  IN_REPAIR    // đang sửa chữa
  RESOLVED     // đã xử lý xong
  CANCELLED
}

// Phân biệt 2 luồng dùng chung model (kế hoạch, phiếu, yêu cầu vật tư)
enum WorkType {
  MAINTENANCE // bảo dưỡng
  REPAIR      // sửa chữa
}

// Trạng thái kế hoạch sửa chữa / bảo dưỡng — duyệt 2 cấp: GĐ xưởng → Công ty
enum WorkPlanStatus {
  DRAFT
  PENDING_FACTORY // chờ giám đốc xưởng duyệt
  PENDING_COMPANY // chờ công ty duyệt
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

// Trạng thái phiếu sửa chữa / phiếu bảo dưỡng MMTB
enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS // đang thực hiện
  DONE        // xong việc, chờ bàn giao
  HANDED_OVER // đã bàn giao lại cho bộ phận sử dụng
  CANCELLED
}

// Trạng thái phiếu yêu cầu bảo dưỡng
enum MaintenanceRequestStatus {
  PENDING  // chờ cơ điện tiếp nhận
  ACCEPTED // đã tiếp nhận
  PLANNED  // đã đưa vào kế hoạch bảo dưỡng
  DONE     // đã thực hiện xong
  REJECTED
}

// Trạng thái yêu cầu mua vật tư — duyệt 2 cấp: GĐ xưởng → Công ty
enum PartRequestStatus {
  DRAFT
  PENDING_FACTORY
  PENDING_COMPANY
  APPROVED
  PURCHASED // đã mua và nhập kho
  REJECTED
  CANCELLED
}

// Loại biến động kho phụ tùng
enum StockMovementType {
  IN     // nhập kho
  OUT    // xuất dùng cho sửa chữa / bảo dưỡng
  ADJUST // điều chỉnh sau kiểm kê
}

// Loại tài liệu hồ sơ máy
enum MachineDocumentType {
  MANUAL      // tài liệu hướng dẫn sử dụng
  INVOICE     // hóa đơn / chứng từ mua
  CONTRACT    // hợp đồng
  CERTIFICATE // chứng chỉ, kiểm định
  DRAWING     // bản vẽ kỹ thuật
  IMAGE
  OTHER
}

// ---------- KHỐI 1: KHAI BÁO MÁY MÓC THIẾT BỊ ----------

// Biên bản bàn giao máy (nhận máy mới / sau sửa chữa / sau bảo dưỡng).
// Quy trình 2 bước xác nhận giống điều chuyển máy: bên giao ký → bên nhận ký.
model MachineHandover {
  id          Int          @id @default(autoincrement())
  handoverNo  String       @unique
  type        HandoverType
  machineId   Int
  factoryId   Int
  lineId      Int? // bàn giao máy về chuyền nào (nếu có)
  workOrderId Int?         @unique // biên bản bàn giao sau sửa chữa/bảo dưỡng gắn với 1 phiếu

  handoverDate DateTime @db.Date
  fromParty    String? // bên giao ngoài hệ thống (nhà cung cấp, đơn vị vận chuyển...)
  senderId     Int? // employeeId bên giao (nội bộ)
  receiverId   Int? // employeeId bên nhận
  condition    String? // tình trạng máy tại thời điểm bàn giao
  accessories  String? // phụ kiện, đồ nghề kèm theo
  note         String?

  status              HandoverStatus @default(DRAFT)
  senderConfirmedAt   DateTime?
  receiverConfirmedAt DateTime?
  rejectReason        String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine   Machine         @relation(fields: [machineId], references: [id])
  factory   Factory         @relation(fields: [factoryId], references: [id])
  line      ProductionLine? @relation(fields: [lineId], references: [id])
  workOrder WorkOrder?      @relation(fields: [workOrderId], references: [id])

  @@index([machineId])
  @@index([factoryId])
  @@index([type])
  @@index([status])
  @@index([handoverDate])
}

// Chứng chỉ / kiểm định của máy (theo dõi thời hạn)
model MachineCertificate {
  id         Int             @id @default(autoincrement())
  machineId  Int
  type       CertificateType @default(INSPECTION)
  certNo     String?
  name       String
  issuedBy   String? // đơn vị cấp
  issueDate  DateTime?       @db.Date
  expiryDate DateTime?       @db.Date // hết hạn — dùng để cảnh báo
  fileUrl    String?
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([expiryDate])
  @@index([deletedAt])
}

// Tài liệu đính kèm hồ sơ máy
model MachineDocument {
  id         Int                 @id @default(autoincrement())
  machineId  Int
  type       MachineDocumentType @default(OTHER)
  name       String
  url        String
  filename   String?
  note       String?
  uploadedBy Int?
  createdAt  DateTime            @default(now())
  deletedAt  DateTime?

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([type])
  @@index([deletedAt])
}

// Định mức bảo dưỡng: chu kỳ + hạng mục kiểm tra + vật tư tiêu hao chuẩn.
// Áp theo chủng loại máy (categoryId) hoặc riêng cho 1 máy (machineId).
model MaintenanceNorm {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  categoryId     Int?
  machineId      Int?
  intervalDays   Int // chu kỳ bảo dưỡng (ngày)
  estimatedHours Decimal?  @db.Decimal(6, 2)
  estimatedCost  Decimal?  @db.Decimal(15, 2)
  checklist      String? // các hạng mục kiểm tra, mỗi dòng một mục
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  category MachineCategory?      @relation(fields: [categoryId], references: [id])
  machine  Machine?              @relation(fields: [machineId], references: [id])
  items    MaintenanceNormItem[]

  @@index([categoryId])
  @@index([machineId])
  @@index([deletedAt])
}

// Định mức vật tư cho 1 lần bảo dưỡng theo định mức
model MaintenanceNormItem {
  id          Int     @id @default(autoincrement())
  normId      Int
  sparePartId Int?
  name        String
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  note        String?

  norm      MaintenanceNorm @relation(fields: [normId], references: [id], onDelete: Cascade)
  sparePart SparePart?      @relation(fields: [sparePartId], references: [id])

  @@index([normId])
  @@index([sparePartId])
}

// ---------- KHỐI 2: SỬA CHỮA ----------

// Phiếu báo hỏng — do cơ điện lập khi máy gặp sự cố
model BreakdownReport {
  id        Int    @id @default(autoincrement())
  reportNo  String @unique
  machineId Int
  factoryId Int
  lineId    Int?

  severity          BreakdownSeverity @default(MEDIUM)
  status            BreakdownStatus   @default(REPORTED)
  symptom           String // hiện tượng hỏng
  stoppedProduction Boolean           @default(false) // có làm dừng sản xuất không
  imageUrls         String[] // ảnh hiện trạng

  reportedBy     Int // employeeId người lập phiếu
  reportedAt     DateTime  @default(now())
  acknowledgedBy Int?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine        Machine         @relation(fields: [machineId], references: [id])
  factory        Factory         @relation(fields: [factoryId], references: [id])
  line           ProductionLine? @relation(fields: [lineId], references: [id])
  incidentReport IncidentReport?
  workOrders     WorkOrder[]
  partRequests   PartRequest[]

  @@index([machineId])
  @@index([factoryId])
  @@index([status])
  @@index([reportedAt])
}

// Biên bản sự cố — lập cho hỏng hóc nghiêm trọng, ghi nguyên nhân & trách nhiệm
model IncidentReport {
  id                Int    @id @default(autoincrement())
  incidentNo        String @unique
  machineId         Int
  factoryId         Int
  breakdownReportId Int?   @unique

  incidentDate     DateTime
  description      String // diễn biến sự cố
  cause            String? // nguyên nhân
  consequence      String? // hậu quả
  downtimeHours    Decimal? @db.Decimal(8, 2)
  damageValue      Decimal? @db.Decimal(15, 2)
  responsibleParty String? // bên chịu trách nhiệm
  preventiveAction String? // biện pháp khắc phục, phòng ngừa
  witnesses        String? // thành phần tham gia lập biên bản
  imageUrls        String[]

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine         Machine          @relation(fields: [machineId], references: [id])
  factory         Factory          @relation(fields: [factoryId], references: [id])
  breakdownReport BreakdownReport? @relation(fields: [breakdownReportId], references: [id])

  @@index([machineId])
  @@index([factoryId])
  @@index([incidentDate])
}

// ---------- KHỐI 3: BẢO DƯỠNG ----------

// Phiếu yêu cầu bảo dưỡng — đề nghị bảo dưỡng máy trước khi lập kế hoạch
model MaintenanceRequest {
  id          Int       @id @default(autoincrement())
  requestNo   String    @unique
  machineId   Int
  factoryId   Int
  requestedBy Int
  requestedAt DateTime  @default(now())
  desiredDate DateTime? @db.Date
  reason      String

  status       MaintenanceRequestStatus @default(PENDING)
  handledBy    Int?
  handledAt    DateTime?
  rejectReason String?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine    Machine     @relation(fields: [machineId], references: [id])
  factory    Factory     @relation(fields: [factoryId], references: [id])
  workOrders WorkOrder[]

  @@index([machineId])
  @@index([factoryId])
  @@index([status])
}

// ---------- KẾ HOẠCH SỬA CHỮA / BẢO DƯỠNG (duyệt 2 cấp) ----------

model WorkPlan {
  id         Int      @id @default(autoincrement())
  planNo     String   @unique
  type       WorkType
  factoryId  Int
  title      String
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  status             WorkPlanStatus @default(DRAFT)
  totalEstimatedCost Decimal?       @db.Decimal(15, 2)
  note               String?

  createdBy         Int
  factoryApprovedBy Int?
  factoryApprovedAt DateTime?
  companyApprovedBy Int?
  companyApprovedAt DateTime?
  rejectReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory      Factory        @relation(fields: [factoryId], references: [id])
  items        WorkPlanItem[]
  partRequests PartRequest[]

  @@index([factoryId])
  @@index([type])
  @@index([status])
  @@index([periodFrom])
}

// Một dòng trong kế hoạch: máy nào, làm gì, ngày nào, chi phí dự kiến
model WorkPlanItem {
  id            Int      @id @default(autoincrement())
  planId        Int
  machineId     Int
  normId        Int?
  plannedDate   DateTime @db.Date
  content       String
  estimatedCost Decimal? @db.Decimal(15, 2)
  note          String?

  plan      WorkPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  machine   Machine    @relation(fields: [machineId], references: [id])
  workOrder WorkOrder? // phiếu thực hiện tương ứng (nếu đã làm)

  @@index([planId])
  @@index([machineId])
  @@index([plannedDate])
}

// ---------- PHIẾU SỬA CHỮA / PHIẾU BẢO DƯỠNG MMTB ----------

model WorkOrder {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique
  type      WorkType
  machineId Int
  factoryId Int

  // Nguồn phát sinh công việc (tối đa một trong các nguồn)
  breakdownReportId    Int?
  maintenanceRequestId Int?
  planItemId           Int? @unique

  status     WorkOrderStatus @default(DRAFT)
  startedAt  DateTime?
  finishedAt DateTime?

  performedBy Int // employeeId cơ điện phụ trách
  assistants  String? // người phối hợp
  content     String // nội dung công việc
  findings    String? // tình trạng phát hiện khi kiểm tra
  result      String? // kết quả sau khi làm

  downtimeHours Decimal?  @db.Decimal(8, 2)
  laborCost     Decimal?  @db.Decimal(15, 2)
  partsCost     Decimal?  @db.Decimal(15, 2) // tổng tiền vật tư, tính từ parts
  totalCost     Decimal?  @db.Decimal(15, 2)
  nextDueDate   DateTime? @db.Date // hạn bảo dưỡng kế tiếp
  note          String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine            Machine             @relation(fields: [machineId], references: [id])
  factory            Factory             @relation(fields: [factoryId], references: [id])
  breakdownReport    BreakdownReport?    @relation(fields: [breakdownReportId], references: [id])
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  planItem           WorkPlanItem?       @relation(fields: [planItemId], references: [id])
  parts              WorkOrderPart[]
  handover           MachineHandover?
  stockMovements     StockMovement[]
  partRequests       PartRequest[]

  @@index([machineId])
  @@index([factoryId])
  @@index([type])
  @@index([status])
  @@index([finishedAt])
}

// Vật tư/phụ tùng tiêu hao trong một phiếu sửa chữa/bảo dưỡng
model WorkOrderPart {
  id          Int      @id @default(autoincrement())
  workOrderId Int
  sparePartId Int?
  name        String
  unit        String?
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal? @db.Decimal(15, 2)
  amount      Decimal? @db.Decimal(15, 2)
  fromStock   Boolean  @default(true) // true: xuất kho xưởng, false: mua ngoài
  note        String?

  workOrder WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePart SparePart? @relation(fields: [sparePartId], references: [id])

  @@index([workOrderId])
  @@index([sparePartId])
}

// ---------- KHỐI 4: VẬT TƯ, PHỤ TÙNG ----------

// Yêu cầu mua vật tư phục vụ sửa chữa / bảo dưỡng (duyệt 2 cấp)
model PartRequest {
  id        Int      @id @default(autoincrement())
  requestNo String   @unique
  type      WorkType
  factoryId Int

  // Gắn với nguồn phát sinh nhu cầu (tùy chọn)
  workPlanId        Int?
  workOrderId       Int?
  breakdownReportId Int?

  title       String
  reason      String?
  requestDate DateTime  @db.Date
  neededDate  DateTime? @db.Date

  status      PartRequestStatus @default(DRAFT)
  totalAmount Decimal?          @db.Decimal(15, 2)

  requestedBy       Int
  factoryApprovedBy Int?
  factoryApprovedAt DateTime?
  companyApprovedBy Int?
  companyApprovedAt DateTime?
  rejectReason      String?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory         Factory           @relation(fields: [factoryId], references: [id])
  workPlan        WorkPlan?         @relation(fields: [workPlanId], references: [id])
  workOrder       WorkOrder?        @relation(fields: [workOrderId], references: [id])
  breakdownReport BreakdownReport?  @relation(fields: [breakdownReportId], references: [id])
  items           PartRequestItem[]
  stockMovements  StockMovement[]

  @@index([factoryId])
  @@index([type])
  @@index([status])
  @@index([requestDate])
}

model PartRequestItem {
  id          Int     @id @default(autoincrement())
  requestId   Int
  sparePartId Int?
  name        String
  unit        String?
  quantity    Decimal @db.Decimal(12, 2)
  // Tồn kho tại thời điểm lập yêu cầu (lưu lại để đối chiếu khi duyệt)
  stockQuantity    Decimal? @db.Decimal(12, 2)
  estimatedPrice   Decimal? @db.Decimal(15, 2)
  amount           Decimal? @db.Decimal(15, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(12, 2) // đã nhập kho
  note             String?

  request   PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sparePart SparePart?  @relation(fields: [sparePartId], references: [id])

  @@index([requestId])
  @@index([sparePartId])
}

// Tồn kho phụ tùng theo từng xưởng
model SparePartStock {
  id          Int      @id @default(autoincrement())
  sparePartId Int
  factoryId   Int
  quantity    Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity Decimal  @default(0) @db.Decimal(12, 2) // tồn tối thiểu, dưới mức này thì cảnh báo
  location    String? // vị trí trong kho
  updatedAt   DateTime @updatedAt

  sparePart SparePart @relation(fields: [sparePartId], references: [id])
  factory   Factory   @relation(fields: [factoryId], references: [id])

  @@unique([sparePartId, factoryId])
  @@index([factoryId])
}

// Sổ biến động kho phụ tùng (thẻ kho) — mọi lần nhập/xuất/kiểm kê
model StockMovement {
  id           Int               @id @default(autoincrement())
  sparePartId  Int
  factoryId    Int
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 2) // luôn dương, hướng xác định bởi type
  unitPrice    Decimal?          @db.Decimal(15, 2)
  amount       Decimal?          @db.Decimal(15, 2)
  balanceAfter Decimal           @db.Decimal(12, 2) // tồn sau biến động

  movementDate  DateTime @default(now())
  workOrderId   Int? // xuất dùng cho phiếu sửa chữa/bảo dưỡng nào
  partRequestId Int? // nhập theo yêu cầu mua nào
  supplier      String?
  documentNo    String?
  reason        String?
  performedBy   Int?
  note          String?

  createdAt DateTime @default(now())

  sparePart   SparePart    @relation(fields: [sparePartId], references: [id])
  factory     Factory      @relation(fields: [factoryId], references: [id])
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  partRequest PartRequest? @relation(fields: [partRequestId], references: [id])

  @@index([sparePartId])
  @@index([factoryId])
  @@index([type])
  @@index([movementDate])
}

// ---------- KHỐI 5: LÝ LỊCH MÁY ----------

// Nhật ký thay đổi trạng thái máy — phục vụ "Theo dõi trạng thái MMTB"
model MachineStatusLog {
  id         Int            @id @default(autoincrement())
  machineId  Int
  fromStatus MachineStatus?
  toStatus   MachineStatus
  reason     String?
  refType    String? // BREAKDOWN / WORK_ORDER / TRANSFER / HANDOVER / LIQUIDATION / MANUAL
  refId      Int?
  changedBy  Int?
  changedAt  DateTime       @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
  @@index([changedAt])
}
